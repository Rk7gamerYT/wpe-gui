diff --git a/src/WallpaperEngine/Audio/Drivers/Recorders/Spectrum.h b/src/WallpaperEngine/Audio/Drivers/Recorders/Spectrum.h
new file mode 100644
--- /dev/null
+++ b/src/WallpaperEngine/Audio/Drivers/Recorders/Spectrum.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+
+namespace WallpaperEngine::Audio::Drivers::Recorders {
+// 64 logarithmic bands spanning 20 Hz to min(20 kHz, Nyquist).
+// Each positive FFT bin belongs to exactly one band. DC is excluded.
+// The FFT must use a Hann window; 4/N restores a full-scale sine's amplitude.
+template <typename Complex>
+void spectrumPowers (const Complex* fft, int samples, float rate, float (&powers)[64]) {
+    std::fill (std::begin (powers), std::end (powers), 0.0f);
+    const float high = std::min (20000.0f, rate * 0.5f);
+    if (samples < 2 || high <= 20.0f) return;
+    const float logRange = std::log (high / 20.0f);
+    const float normalization = 16.0f / (samples * static_cast<float> (samples));
+    for (int bin = 1; bin <= samples / 2; ++bin) {
+        const float frequency = bin * rate / samples;
+        if (frequency < 20.0f || frequency > high) continue;
+        const int band = std::clamp (static_cast<int> (64 * std::log (frequency / 20.0f) / logRange), 0, 63);
+        const float power = (fft[bin].r * fft[bin].r + fft[bin].i * fft[bin].i) * normalization;
+        if (std::isfinite (power)) powers[band] = std::max (powers[band], power);
+    }
+}
+} // namespace WallpaperEngine::Audio::Drivers::Recorders

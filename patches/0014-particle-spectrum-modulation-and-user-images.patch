+}
+bool AlbumTexture::loadFile (const std::string& path) const {
+    int width = 0, height = 0, channels = 0;
+    GLint maximum = 0;
+    glGetIntegerv (GL_MAX_TEXTURE_SIZE, &maximum);
+    if (!stbi_info (path.c_str (), &width, &height, &channels) || width < 1 || height < 1
+        || width > maximum || height > maximum || uint64_t (width) * height > 64 * 1024 * 1024) return false;
+    auto* data = stbi_load (path.c_str (), &width, &height, &channels, 4);
+    if (!data) return false;
+    ScopeGuard guard ([data] { stbi_image_free (data); });
+    glBindTexture (GL_TEXTURE_2D, m_textureID);
+    glTexImage2D (GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, data);
+    m_width = width;
+    m_height = height;
+    m_resolution = glm::vec4 (width, height, width, height);
+    return true;
+}

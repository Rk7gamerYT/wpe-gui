diff --git a/src/WallpaperEngine/Render/Objects/ParticleAudio.h b/src/WallpaperEngine/Render/Objects/ParticleAudio.h
new file mode 100644
--- /dev/null
+++ b/src/WallpaperEngine/Render/Objects/ParticleAudio.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+
+namespace WallpaperEngine::Render::Objects {
+// Authored bands are inclusive indices into the 16-band spectrum.
+inline float particleAudioFactor (const float* spectrum, int mode, float low, float high,
+                                  float exponent, int first, int last) {
+    if (mode <= 0) return 1.0f;
+    first = std::clamp (first, 0, 15);
+    last = std::clamp (last, 0, 15);
+    if (first > last) std::swap (first, last);
+    float sum = 0;
+    for (int i = first; i <= last; ++i)
+        sum += std::isfinite (spectrum[i]) ? std::clamp (spectrum[i], 0.0f, 1.0f) : 0.0f;
+    const float amplitude = sum / (last - first + 1);
+    if (!std::isfinite (low) || !std::isfinite (high)) return 0;
+    if (low > high) std::swap (low, high);
+    const float normalized = high > low ? std::clamp ((amplitude - low) / (high - low), 0.0f, 1.0f)
+                                        : (amplitude > low ? 1.0f : 0.0f);
+    exponent = std::isfinite (exponent) ? std::clamp (exponent, 0.01f, 64.0f) : 1.0f;
+    return std::pow (normalized, exponent);
+}
+}

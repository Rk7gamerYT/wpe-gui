index c63331b..89824ed 100644
--- a/src/WallpaperEngine/Audio/Drivers/Recorders/AudioResponseControl.h
+++ b/src/WallpaperEngine/Audio/Drivers/Recorders/AudioResponseControl.h
@@ -18,4 +18,13 @@ inline float loadSpectrumCurve (const char* path, float current) {
     return value > 0.0f ? value : current;
 }
 
+inline float loadSpectrumGain (const char* path, float current) {
+    if (!path || !*path) return current;
+    std::ifstream input (path);
+    float value;
+    if (!(input >> value) || !std::isfinite (value)) return current;
+    input >> std::ws;
+    return input.eof () && value >= 0.0f && value <= 4.0f ? value : current;
+}
+
 }

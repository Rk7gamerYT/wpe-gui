+
+CObject* CScene::createImageLayer (const std::string& requestedModel, const std::string& config) {
+    if (m_dynamicObjects.size () >= 1024) throw std::runtime_error ("Dynamic image layer limit reached");
+    std::string model = requestedModel;
+    try { this->getAssetLocator ().readString (model); }
+    catch (const std::exception&) {
+        // Workshop imports relocate model assets; accept an unambiguous basename from a loaded image.
+        std::string resolved;
+        for (const auto& object : this->getScene ().objects) {
+            if (!object->is<Image> ()) continue;
+            const auto& candidate = object->as<Image> ()->model->filename;
+            if (std::filesystem::path (candidate).filename () != std::filesystem::path (model).filename ()) continue;
+            if (!resolved.empty () && resolved != candidate) throw std::runtime_error ("Ambiguous dynamic image model");
+            resolved = candidate;
+        }
+        if (resolved.empty ()) throw;
+        model = resolved;
+    }
+    int id = m_objects.empty () ? 1 : m_objects.rbegin ()->first + 1;
+    auto json = config.empty () ? Data::JSON::JSON::object () : Data::JSON::JSON::parse (config);
+    json["id"] = id;
+    if (!json.contains ("name")) json["name"] = model;
+    json["image"] = model;
+    auto data = ObjectParser::parse (json, this->getScene ().project);
+    CObject* object = this->createObject (*data);
+    if (!object) throw std::runtime_error ("Cannot create image layer");
+    m_dynamicObjects.push_back (std::move (data));
+    m_objectsByRenderOrder.push_back (object);
+    return object;
+}
+
+int CScene::layerIndex (int id) const {
+    for (size_t i = 0; i < m_objectsByRenderOrder.size (); ++i) if (m_objectsByRenderOrder[i]->getId () == id) return static_cast<int> (i);
+    return -1;
+}
+
+void CScene::sortLayer (int id, int index) {
+    int oldIndex = this->layerIndex (id);
+    if (oldIndex < 0) return;
+    auto* object = m_objectsByRenderOrder[oldIndex];
+    m_objectsByRenderOrder.erase (m_objectsByRenderOrder.begin () + oldIndex);
+    index = std::clamp (index, 0, static_cast<int> (m_objectsByRenderOrder.size ()));
+    m_objectsByRenderOrder.insert (m_objectsByRenderOrder.begin () + index, object);
+}

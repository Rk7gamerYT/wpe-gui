+static JSON parseEditorMetadata (std::string content) {
+    const auto first = content.find_first_not_of (" \t\r\n");
+    if (first == std::string::npos || content[first] != '{') return JSON::object ();
+    try { return JSON::parse (content, nullptr, true, true); }
+    catch (const std::exception&) {
+        content = std::regex_replace (content, std::regex (R"(([{,]\s*)([A-Za-z_]\w*)\s*:)"), "$1\"$2\":");
+        const std::regex range (R"(\[\s*[-+0-9.eE]+(?:\s+[-+0-9.eE]+)+\s*\])");
+        std::smatch match;
+        std::string repaired;
+        while (std::regex_search (content, match, range)) {
+            repaired += match.prefix ().str ();
+            const auto value = match.str ();
+            std::string numbers = value.substr (1, value.size () - 2);
+            const auto start = numbers.find_first_not_of (" \t\r\n");
+            const auto end = numbers.find_last_not_of (" \t\r\n");
+            numbers = numbers.substr (start, end - start + 1);
+            repaired += "[" + std::regex_replace (numbers, std::regex (R"(\s+)"), ",") + "]";
+            content = match.suffix ().str ();
+        }
+        content = repaired + content;
+        return JSON::parse (content, nullptr, true, true);
+    }
+}

+void ScriptEngine::forgetObject (const ScriptableObject& object) {
+    // A renderer can fail setup after its constructor has queued property scripts.
+    // Remove these references before the layer and its DynamicValues are released.
+    if (m_shuttingDown) return;
+    for (auto it = m_scriptOrder.begin (); it != m_scriptOrder.end ();) {
+        auto module = m_scriptModules.find (*it);
+        if (module == m_scriptModules.end () || module->second.object != &object) { ++it; continue; }
+        JS_FreeValue (m_context, module->second.module);
+        m_scriptModules.erase (module);
+        it = m_scriptOrder.erase (it);
+    }

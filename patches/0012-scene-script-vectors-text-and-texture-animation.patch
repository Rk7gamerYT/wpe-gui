+    matrix = glm::rotate (matrix, angles.z, glm::vec3 (0,0,1));
+    matrix = glm::rotate (matrix, angles.y, glm::vec3 (0,1,0));
+    matrix = glm::rotate (matrix, angles.x, glm::vec3 (1,0,0));

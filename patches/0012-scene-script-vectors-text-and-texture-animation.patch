-double CRenderable::getAnimationTime () const { return this->m_animationTime; }
\ No newline at end of file
+double CRenderable::getAnimationTime () const { return this->m_animationTime; }
+uint32_t CRenderable::getAnimationFrameCount () const {
+    return m_texture ? m_texture->getFrames ().size () : 0;
+}
+double CRenderable::getAnimationPosition () const {
+    const double now = getContext ().getDriver ().getRenderTime ();
+    if (!m_scriptAnimationControlled) return now;
+    const double dt = std::max (0.0, now - m_scriptAnimationLast);
+    if (m_scriptAnimationPlaying) m_scriptAnimationPosition += dt * m_scriptAnimationRate;
+    m_scriptAnimationLast = now;
+    return m_scriptAnimationPosition;
+}
+uint32_t CRenderable::getAnimationFrame () const {
+    if (!m_texture || m_animationTime <= 0 || getAnimationFrameCount () == 0) return 0;
+    double time = std::fmod (getAnimationPosition (), m_animationTime);
+    if (time < 0) time += m_animationTime;
+    uint32_t index = 0;
+    for (const auto& frame : m_texture->getFrames ()) {
+        time -= frame->frametime;
+        if (time <= 0) return index;
+        ++index;
+    }
+    return getAnimationFrameCount () - 1;
+}
+void CRenderable::setAnimationPlaying (bool playing) {
+    const double position = getAnimationPosition ();
+    m_scriptAnimationPosition = position;
+    m_scriptAnimationLast = getContext ().getDriver ().getRenderTime ();
+    m_scriptAnimationControlled = true;
+    m_scriptAnimationPlaying = playing;
+}
+void CRenderable::setAnimationRate (double rate) {
+    if (!std::isfinite (rate)) return;
+    setAnimationPlaying (m_scriptAnimationPlaying);
+    m_scriptAnimationRate = rate;
+}
+void CRenderable::setAnimationFrame (double frame) {
+    if (!std::isfinite (frame) || !m_texture || getAnimationFrameCount () == 0) return;
+    const auto index = static_cast<uint32_t> (std::clamp (frame, 0.0, double (getAnimationFrameCount () - 1)));
+    setAnimationPlaying (m_scriptAnimationPlaying);
+    m_scriptAnimationPosition = 0;
+    for (uint32_t i = 0; i < index; ++i) m_scriptAnimationPosition += m_texture->getFrames ()[i]->frametime;
+    // Frame selection uses an interior time so an exact boundary cannot select the previous frame.
+    m_scriptAnimationPosition += m_texture->getFrames ()[index]->frametime * 0.001;
+}

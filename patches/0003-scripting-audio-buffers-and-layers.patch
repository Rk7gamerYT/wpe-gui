+
+JSValue scene_enumerate_layers (JSContext* ctx, JSValueConst self, int, JSValueConst*) {
+    auto* container = get_opaque (self);
+    JSValue array = JS_NewArray (ctx);
+    int index = 0;
+    for (auto* layer : container->getScene ().getObjectsByRenderOrder ()) {

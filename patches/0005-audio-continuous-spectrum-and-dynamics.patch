+    // Sub-bin bass bands would otherwise remain permanently empty at this FFT size.
+    // Interpolate their center frequency; populated bands retain their real peak.
+    for (int band = 0; band < 64; ++band) {
+        const float lo = 20.0f * std::exp (logRange * band / 64.0f) * samples / rate;
+        const float hi = 20.0f * std::exp (logRange * (band + 1) / 64.0f) * samples / rate;
+        if (std::ceil (lo) < hi) continue;
+        const float center = std::sqrt (lo * hi);
+        const int left = std::clamp (static_cast<int> (center), 1, samples / 2 - 1);
+        auto binPower = [&] (int bin) {
+            const float value = (fft[bin].r * fft[bin].r + fft[bin].i * fft[bin].i) * normalization;
+            return std::isfinite (value) ? value : 0.0f;
+        };
+        const float fraction = std::clamp (center - left, 0.0f, 1.0f);
+        powers[band] = binPower (left) * (1.0f - fraction) + binPower (left + 1) * fraction;
+    }

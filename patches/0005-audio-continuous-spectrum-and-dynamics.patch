diff --git a/src/WallpaperEngine/Audio/Drivers/Recorders/AudioAnalysis.h b/src/WallpaperEngine/Audio/Drivers/Recorders/AudioAnalysis.h
new file mode 100644
index 0000000..ee92c3e
--- /dev/null
+++ b/src/WallpaperEngine/Audio/Drivers/Recorders/AudioAnalysis.h
@@ -0,0 +1,68 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+
+namespace WallpaperEngine::Audio::Drivers::Recorders {
+// Single-threaded rolling capture window, shared by the PA callbacks and render tick.
+template <size_t Size> struct AudioSampleWindow {
+    std::array<float, Size> data {};
+    size_t next = 0;
+    bool dirty = false;
+    void clear () { data.fill (0.0f); next = 0; dirty = false; }
+    void push (float value) {
+        data[next] = std::isfinite (value) ? std::clamp (value, -1.0f, 1.0f) : 0.0f;
+        next = (next + 1) % Size;
+        dirty = true;
+    }
+    void windowed (float* output) const {
+        float mean = 0.0f;
+        for (float value : data) mean += value;
+        mean /= Size;
+        for (size_t i = 0; i < Size; ++i) {
+            const float window = 0.5f * (1.0f - std::cos (2.0f * 3.14159265358979323846f * i / Size));
+            output[i] = (data[(next + i) % Size] - mean) * window;
+        }
+    }
+};
+inline float spectrumLevel (float power, float gain) {
+    if (!std::isfinite (power) || power <= 0.0f || !std::isfinite (gain) || gain <= 0.0f) return 0.0f;
+    // -72 dBFS floor retains quieter harmonics without auto-amplifying silence.
+    return std::clamp ((10.0f * std::log10 (power) + 72.0f) / 72.0f * gain, 0.0f, 1.0f);
+}
+// Relative spectral shape plus positive spectral flux: equal-volume notes and
+// percussion still move different bands. A bounded shared reference preserves
+// the relation between bands and prevents background noise from filling the display.
+struct SpectrumDynamics {
+    float reference = 0.01f;
+    std::array<float, 64> previous {};
+    void levels (const float (&powers)[64], float gain, float dt, float (&output)[64]) {
+        float peak = 0.0f;
+        for (float power : powers) if (std::isfinite (power)) peak = std::max (peak, power);
+        const float target = std::max (peak, 0.0001f);
+        const float seconds = target > reference ? 0.025f : 0.8f;
+        reference += (target - reference) * -std::expm1 (-std::max (0.0f, dt) / seconds);
+        reference = std::max (reference, 0.0001f);
+        for (int band = 0; band < 64; ++band) {
+            const float power = std::isfinite (powers[band]) ? std::max (0.0f, powers[band]) : 0.0f;
+            const float shape = std::pow (std::clamp (power / reference, 0.0f, 1.0f), 0.35f);
+            const float flux = std::sqrt (std::clamp ((power - previous[band]) / reference, 0.0f, 1.0f));
+            const float gate = std::clamp ((power - 0.00000006f) / 0.00000094f, 0.0f, 1.0f);
+            const float activity = (0.75f * shape + 0.25f * flux) * gate;
+            // Compress high sensitivity smoothly instead of clipping every strong band.
+            output[band] = std::isfinite (gain) && gain > 0.0f
+                ? std::clamp (activity * gain / (1.0f + std::max (0.0f, gain - 1.0f) * activity), 0.0f, 1.0f) : 0.0f;
+            previous[band] = power;
+        }
+    }
+};
+inline float smoothSpectrum (float current, float target, float dt) {
+    if (!std::isfinite (current)) current = 0.0f;
+    if (!std::isfinite (target)) target = 0.0f;
+    if (!std::isfinite (dt) || dt <= 0.0f) return current;
+    const float seconds = target > current ? 0.018f : 0.140f;
+    const float alpha = -std::expm1 (-dt / seconds);
+    return std::clamp (current + (target - current) * alpha, 0.0f, 1.0f);
+}
+} // namespace WallpaperEngine::Audio::Drivers::Recorders

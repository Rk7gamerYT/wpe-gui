+static JSON resolveProjectPreset (const std::filesystem::path& folder, std::set<std::filesystem::path>& seen,
+                                  std::vector<std::filesystem::path>& dependencies) {
+    const auto canonical = std::filesystem::weakly_canonical (folder);
+    if (seen.size () >= 20 || !seen.insert (canonical).second) throw std::runtime_error ("Cyclic wallpaper preset dependency");
+    std::ifstream input (folder / "project.json");
+    if (!input) throw std::runtime_error ("Wallpaper dependency project not found: " + folder.string ());
+    JSON project; input >> project;
+    if (!project.contains ("dependency")) return project;
+    const auto& dependency = project["dependency"];
+    const std::string id = dependency.is_string () ? dependency.get<std::string> () : std::to_string (dependency.get<long long> ());
+    if (id.empty () || id.find_first_not_of ("0123456789") != std::string::npos)
+        throw std::runtime_error ("Invalid wallpaper dependency id");
+    const auto parent = folder.parent_path () / id;
+    dependencies.push_back (parent);
+    JSON result = resolveProjectPreset (parent, seen, dependencies);
+    if (project.contains ("preset") && project["preset"].is_object ()) {
+        for (auto& [key, value] : project["preset"].items ()) {
+            if (!value.is_null () && result["general"]["properties"].contains (key))
+                result["general"]["properties"][key]["value"] = value;
+        }
+    }
+    for (const char* key : { "title", "preview", "description", "tags", "workshopid" })
+        if (project.contains (key)) result[key] = project[key];
+    result["workshopid"] = folder.filename ().string ();
+    return result;
+}

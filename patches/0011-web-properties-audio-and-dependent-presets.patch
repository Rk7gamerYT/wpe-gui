+void SubprocessApp::OnContextCreated (CefRefPtr<CefBrowser>, CefRefPtr<CefFrame>, CefRefPtr<CefV8Context> context) {
+    const char* source = R"JS(
+(function() {
+    window.__wpeAudioCallbacks = [];
+    window.wallpaperRegisterAudioListener = function(callback) {
+        if (typeof callback !== 'function') throw new TypeError('Audio listener must be a function');
+        window.__wpeAudioCallbacks.push(callback);
+    };
+    window.wallpaperRequestRandomFileForProperty = function(property, callback) {
+        const files = (window.__wpeDirectoryFiles || {})[property] || [];
+        const path = files.length ? files[Math.floor(Math.random() * files.length)] : '';
+        if (typeof callback === 'function') setTimeout(() => callback(property, path), 0);
+    };
+    window.__wpeDeliverAudio = function(data) {
+        for (const callback of window.__wpeAudioCallbacks) {
+            try { callback(data.slice()); } catch (error) { console.error(error); }
+        }
+    };
+})();
+)JS";
+    CefRefPtr<CefV8Value> result;
+    CefRefPtr<CefV8Exception> exception;
+    context->Eval (source, "wpe://bridge", 1, result, exception);
+}

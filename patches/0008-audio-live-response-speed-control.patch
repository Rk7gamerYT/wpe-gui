diff --git a/src/WallpaperEngine/Audio/Drivers/Recorders/AudioResponseControl.h b/src/WallpaperEngine/Audio/Drivers/Recorders/AudioResponseControl.h
new file mode 100644
index 0000000..4410d83
--- /dev/null
+++ b/src/WallpaperEngine/Audio/Drivers/Recorders/AudioResponseControl.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cmath>
+#include <fstream>
+namespace WallpaperEngine::Audio::Drivers::Recorders {
+// Read an atomically replaced scalar JSON value. Missing or partial files retain
+// the current setting. 0 means adaptive; .25..4 are manual speed multipliers.
+inline float loadResponseSpeed (const char* path, float current) {
+    if (!path || !*path) return current;
+    std::ifstream input (path);
+    float value;
+    if (!(input >> value) || !std::isfinite (value)) return current;
+    input >> std::ws;
+    if (!input.eof () || (value != 0.0f && (value < 0.25f || value > 4.0f))) return current;
+    return value;
+}
+}

+// Longer bass window resolves low notes; the short window follows guitar and
+// percussion transients. Crossfade 120..300 Hz to avoid a boundary jump.
+inline void mergeSpectrumWindows (float (&bass)[64], const float (&fast)[64]) {
+    for (int band = 0; band < 64; ++band) {
+        const float hz = 20.0f * std::pow (1000.0f, (band + 0.5f) / 64.0f);
+        const float blend = std::clamp ((hz - 120.0f) / 180.0f, 0.0f, 1.0f);
+        bass[band] = bass[band] * (1.0f - blend) + fast[band] * blend;
+    }
+}
 // Relative spectral shape plus positive spectral flux: equal-volume notes and
 // percussion still move different bands. A bounded shared reference preserves
 // the relation between bands and prevents background noise from filling the display.

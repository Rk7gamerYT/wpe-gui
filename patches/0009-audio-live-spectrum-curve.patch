+// Neutral in automatic mode. Manual curvature expands or compresses the visual
+// response while preserving silence, full scale and the ordering of bands.
+inline float curveSpectrum (float level, float amount = 1.0f) {
+    if (!std::isfinite (level)) return 0.0f;
+    if (!std::isfinite (amount)) amount = 1.0f;
+    amount = std::clamp (amount, 0.25f, 4.0f);
+    return std::pow (std::clamp (level, 0.0f, 1.0f), 1.0f / amount);
+}
 inline float smoothSpectrum (float current, float target, float dt, float speed = 1.0f) {
     if (!std::isfinite (current)) current = 0.0f;
     if (!std::isfinite (target)) target = 0.0f;
